# Скопируйте в .env и заполните значения. Файл .env не коммитится.

# Django
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных: postgresql (нужен запущенный сервер, см. docker-compose.yml) или sqlite3
DB_ENGINE=sqlite3
# Используется только при DB_ENGINE=sqlite3 (по умолчанию db.sqlite3 в корне проекта)
# SQLITE_PATH=db.sqlite3
# Параметры PostgreSQL; их же использует docker-compose.yml
DB_NAME=investing
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# T-Invest API
TINKOFF_TOKEN=
TINVEST_API_URL=https://invest-public-api.tbank.ru/rest
# PEM-файл с корневым сертификатом НУЦ Минцифры (https://www.gosuslugi.ru/crt), если его нет в системе
TINVEST_CA_BUNDLE=
TINVEST_TIMEOUT=10

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
